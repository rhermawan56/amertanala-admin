APP_NAME="Amertanala Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8001
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=amertanala_admin
DB_USERNAME=amertanala_admin
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ENCRYPT=true
SESSION_COOKIE=amertanala_admin_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict
CHAT_COOKIE=amertanala_chat
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
MAIL_MAILER=array
MAIL_FROM_ADDRESS=noreply@amertanala.test
MAIL_FROM_NAME="Amertanala"
LANDING_URL=http://localhost:8000
LANDING_FRAME_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
REVERB_APP_ID=amertanala
REVERB_APP_KEY=generate-a-random-key
REVERB_APP_SECRET=generate-a-random-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
VITE_APP_NAME="Amertanala Studio"
VITE_REVERB_APP_KEY=generate-a-random-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

MYSQLDUMP_PATH=C:/laragon/bin/mysql/mysql-8.3.0-winx64/bin/mysqldump.exe
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Production: HTTPS/WSS, SESSION_SECURE_COOKIE=true, and host-only __Host- cookie names.
# Configure a real SMTP mailer before enabling email recovery and notifications.
# Backups are encrypted with APP_KEY; keep a separate offline copy of the key.
